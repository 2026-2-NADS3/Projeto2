<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".ChatActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cabecalhoChat"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnVoltarChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatarIa"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="#8B5CF6"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnVoltarChat">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="IA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtNomeSuporte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suporte Próxima Etapa"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/cardAvatarIa"
            app:layout_constraintTop_toTopOf="@id/cardAvatarIa" />

        <TextView
            android:id="@+id/txtStatusOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● On-line agora"
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/cardAvatarIa"
            app:layout_constraintTop_toBottomOf="@id/txtNomeSuporte" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rodapeChat"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/edtMensagem"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Digite sua dúvida..."
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:background="@drawable/bg_input_chat"
            android:paddingStart="16dp"
            android:paddingEnd="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnEnviarMensagem"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_send"
            app:backgroundTint="@null"
            android:layout_marginEnd="6dp"
            app:layout_constraintTop_toTopOf="@id/edtMensagem"
            app:layout_constraintBottom_toBottomOf="@id/edtMensagem"
            app:layout_constraintEnd_toEndOf="@id/edtMensagem" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/cabecalhoChat"
        app:layout_constraintBottom_toTopOf="@id/rodapeChat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/containerMensagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/msgBot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="270dp"
                android:text="Olá, João! Como posso te ajudar com seus cursos hoje?"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:background="@drawable/bg_bubble_bot"
                android:padding="14dp"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/msgUser1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="270dp"
                android:text="Como faço para emitir meu certificado?"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_bubble_user"
                android:padding="14dp"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/msgBot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="270dp"
                android:text="É bem simples! Basta acessar a aba Perfil &gt; Certificados e clicar no botão &quot;Baixar PDF&quot;."
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:background="@drawable/bg_bubble_bot"
                android:padding="14dp"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
