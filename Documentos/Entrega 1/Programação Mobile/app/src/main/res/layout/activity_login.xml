<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:padding="24dp"
    tools:context=".LoginActivity">

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_logo_purple"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtLetraLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/txtNomeApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próxima Etapa"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/boxLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/lblEmailCpf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail ou CPF"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/txtNomeApp"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edtEmailCpf"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:hint="aluno@escola.sp.gov.br"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblEmailCpf"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/lblSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/edtEmailCpf"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:hint="••••••••••••"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblSenha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtEsqueceuSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esqueceu a senha?"
                android:textColor="#8B5CF6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/edtSenha"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:text="Entrar no App"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_green"
                app:backgroundTint="@null"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txtEsqueceuSenha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnCriarConta"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:text="Criar minha conta"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_secondary"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/btnEntrar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
