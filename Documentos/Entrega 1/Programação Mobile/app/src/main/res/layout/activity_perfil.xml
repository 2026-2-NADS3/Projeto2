<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".Perfil">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cabecalhoPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatarPerfil"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#8B5CF6"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txtInicialPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="JS"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtNomePerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="João Silva Santos"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/cardAvatarPerfil"
            app:layout_constraintTop_toTopOf="@id/cardAvatarPerfil" />

        <TextView
            android:id="@+id/txtSubPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RA: 2026.03.8841 • E.E. Maria José"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toEndOf="@id/cardAvatarPerfil"
            app:layout_constraintTop_toBottomOf="@id/txtNomePerfil" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rodape"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rodape"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Home"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCursos"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnCursos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Cursos"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/btnInicio"
            app:layout_constraintEnd_toStartOf="@id/btnAgenda"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnAgenda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Agenda"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/btnCursos"
            app:layout_constraintEnd_toStartOf="@id/btnPerfil"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Perfil"
            android:textSize="11sp"
            android:textColor="#22C55E"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/btnAgenda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnCertificados"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/cabecalhoPerfil"
        app:layout_constraintBottom_toTopOf="@id/rodape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnMenuCarteira"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Carteira do Estudante (Meu Card)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnMenuFrequencia"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Frequência de Presença &amp; Relatórios"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnMenuCertificados"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Meus Certificados &amp; Conquistas"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnMenuTeste"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Teste Vocacional RIASEC"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnMenuComunicados"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Comunicados &amp; Avisos"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnMenuChat"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Suporte &amp; Chat com IA"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnMenuSair"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sair da Conta"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_card_white"
                app:backgroundTint="@null"
                android:layout_marginTop="20dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
