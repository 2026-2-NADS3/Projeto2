<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:padding="24dp"
    tools:context=".CadastroActivity">

    <Button
        android:id="@+id/btnVoltarCadastro"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:contentDescription="Voltar"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/bg_btn_flat"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scrollCadastro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltarCadastro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Logo do app (arquivo: res/drawable/imglogo) -->
            <ImageView
                android:id="@+id/imgLogoCadastro"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/imglogo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Logo Próxima Etapa"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtTituloCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar Minha Conta"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/imgLogoCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtSubtituloCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preencha seus dados para começar"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/txtTituloCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/lblNomeCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Completo"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txtSubtituloCadastro"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edtNomeCadastro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:hint="Seu nome completo"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblNomeCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/lblEmailCpfCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail ou CPF"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/edtNomeCadastro"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edtEmailCpfCadastro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:hint="aluno@escola.sp.gov.br"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblEmailCpfCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/lblRaCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RA ou Código do Aluno"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/edtEmailCpfCadastro"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edtRaCadastro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:hint="Ex: 2026.03.8841"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblRaCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/lblSenhaCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/edtRaCadastro"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edtSenhaCadastro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:hint="••••••••••••"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblSenhaCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:text="Cadastrar Conta"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_green"
                app:backgroundTint="@null"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/edtSenhaCadastro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>