<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp"
    tools:context=".FrequenciaActivity">

    <Button
        android:id="@+id/btnVoltarFrequencia"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_flat"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTituloFrequencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Frequência de Presença"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollFrequencia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloFrequencia"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Metricas de Presença -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardMetricas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtLabelMetricas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESUMO DE ASSIDUIDADE"
                    android:textColor="#8B5CF6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/rowMetricas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/txtLabelMetricas">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTotalPresencas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18 Aulas"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total de Presenças"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/txtTaxaFrequencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="95%"
                            android:textColor="#22C55E"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Excelente Assiduidade"
                            android:textColor="#15803D"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card Barra de Progresso Frequencia Mínima vs Actual -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardBarraProgresso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtMetaFrequenciaTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frequência Mínima Exigida: 75%"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ProgressBar
                    android:id="@+id/progressFrequencia"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="95"
                    android:progressTint="#22C55E"
                    android:progressBackgroundTint="#E2E8F0"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/txtMetaFrequenciaTitle" />

                <TextView
                    android:id="@+id/txtStatusFrequenciaSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sua frequência atual está 20% acima do mínimo para certificação."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/progressFrequencia"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/txtTituloHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEUS REGISTROS DE PRESENÇA"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Container Dinamico de Registros lidos do SQLite -->
            <LinearLayout
                android:id="@+id/containerHistoricoPresencas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
