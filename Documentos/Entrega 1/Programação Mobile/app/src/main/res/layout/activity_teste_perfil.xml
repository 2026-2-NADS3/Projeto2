<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp"
    tools:context=".TestePerfilActivity">

    <Button
        android:id="@+id/btnVoltarTeste"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_flat"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTituloTeste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teste Vocacional RIASEC"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtContadorPergunta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pergunta 04 de 30"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloTeste"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressTeste"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="30"
        android:progress="4"
        android:progressTint="#8B5CF6"
        android:progressBackgroundTint="#E2E8F0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtContadorPergunta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardPergunta"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_card_white"
        android:padding="20dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/progressTeste"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtPerguntaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Como você prefere resolver problemas no dia a dia?"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtPerguntaSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Escolha a opção que mais combina com seu estilo natural de pensar e agir."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtPerguntaTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/containerOpcoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardPergunta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnOpcaoA"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="A. Analisando dados e criando códigos"
            android:textColor="#8B5CF6"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_option_selected"
            app:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOpcaoB"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="B. Conversando e ajudando pessoas"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_option_unselected"
            app:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOpcaoC"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="C. Organizando processos e tarefas"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_option_unselected"
            app:backgroundTint="@null" />

    </LinearLayout>

    <!-- Card de Resultado & Direcionamento Pós-Teste (Aparece ao finalizar) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardResultadoVocacional"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:padding="20dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressTeste"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTagResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIAGNÓSTICO DA IA"
            android:textColor="#8B5CF6"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtPerfilDetectado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Perfil: Tecnologia &amp; Investigativo (IAE)"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/txtTagResultado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtDiagnosticoIa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sua análise demonstra grande aptidão para solução de problemas lógicos, análise de dados e criação de software."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtPerfilDetectado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtCursosRecomendadosTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cursos Recomendados para Você:"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtDiagnosticoIa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtCursosRecomendadosList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="• Introdução à Programação (40h)\n• Lógica &amp; Algoritmos (Fatec)"
            android:textColor="#22C55E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtCursosRecomendadosTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnVerCursosRecomendados"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Ver Cursos Recomendados →"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_green"
            app:backgroundTint="@null"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/txtCursosRecomendadosList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btnProximaPergunta"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="Próxima Pergunta →"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_green"
        app:backgroundTint="@null"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
