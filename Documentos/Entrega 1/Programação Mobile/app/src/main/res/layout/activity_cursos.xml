<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".CursosActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cabecalho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTituloCursos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cursos &amp; Trilha de Formação"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/edtBuscarCursos"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:hint="Buscar cursos, tópicos..."
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/cabecalho"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Filtros Superiores: Todos / Meus Inscritos -->
    <LinearLayout
        android:id="@+id/containerFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/edtBuscarCursos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnFiltroTodos"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Todos (6)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_green"
            app:backgroundTint="@null"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnFiltroInscritos"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Inscritos"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_option_unselected"
            app:backgroundTint="@null" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rodape"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rodape"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Home"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCursos"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnCursos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Cursos"
            android:textSize="11sp"
            android:textColor="#22C55E"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/btnInicio"
            app:layout_constraintEnd_toStartOf="@id/btnAgenda"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnAgenda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Agenda"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/btnCursos"
            app:layout_constraintEnd_toStartOf="@id/btnPerfil"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Perfil"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_btn_flat"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/btnAgenda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnCertificados"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/containerFiltros"
        app:layout_constraintBottom_toTopOf="@id/rodape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Módulo 1 (Concluído) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCurso1"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerCurso1"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_banner_purple"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtTagCurso1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÓDULO 1 • CONCLUÍDO"
                        android:textColor="#DDD6FE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtNomeCurso1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lógica &amp; Algoritmos"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTagCurso1"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtDescCurso1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Fundamentos de raciocínio lógico e resolução de problemas."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/bannerCurso1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtStatusConcluido"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="Certificado Emitido (100% Concluído)"
                    android:textColor="#15803D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tag_presencial"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Módulo 2 (Inscrito / Em Andamento) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCurso2"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerCurso2"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_banner_purple"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtTagCurso2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÓDULO 2 • TRILHA ATIVA"
                        android:textColor="#DDD6FE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtNomeCurso2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Introdução a Java &amp; Android"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTagCurso2"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtDescCurso2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Aprenda a desenvolver seus próprios aplicativos para celular."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/bannerCurso2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtStatusAndamento"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="Inscrito • Em Andamento (Progresso: 65%)"
                    android:textColor="#22C55E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_card_dark"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Módulo 3 (Workshop / Inscrito) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCurso3"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerCurso3"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_banner_blue"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtTagCurso3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORKSHOP ESPECIAL"
                        android:textColor="#DBEAFE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtNomeCurso3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orientação Vocacional &amp; ENEM"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTagCurso3"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtDescCurso3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Como escolher sua carreira e obter bolsas ProUni/FIES."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/bannerCurso3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtStatusInscrito3"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="Inscrito • Aulas iniciam dia 20/NOV"
                    android:textColor="#D97706"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_banner_yellow"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Módulo 4 (Disponível com Botão "Inscrever-se") -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCurso4"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerCurso4"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_banner_purple"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtTagCurso4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÓDULO 4 • DISPONÍVEL"
                        android:textColor="#DDD6FE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtNomeCurso4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banco de Dados SQL &amp; Nuvem"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTagCurso4"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtDescCurso4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Aprenda a modelar bancos de dados relacionais e conectar à nuvem."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/bannerCurso4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btnInscreverCurso4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Inscrever-se neste Curso"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_green"
                    app:backgroundTint="@null"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Módulo 5 (Bloqueado / Apagado na Trilha) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCurso5"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_white"
                android:alpha="0.55"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerCurso5"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtTagCurso5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÓDULO 5 • TRILHA BLOQUEADA"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtNomeCurso5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desenvolvimento Web Fullstack"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTagCurso5"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtDescCurso5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Construção de aplicações web modernas com frontend e backend."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/bannerCurso5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtStatusBloqueado5"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="Requer conclusão do Módulo 4"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_option_unselected"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Módulo 6 (Bloqueado / Apagado na Trilha) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCurso6"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_white"
                android:alpha="0.55"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerCurso6"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtTagCurso6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÓDULO 6 • TRILHA BLOQUEADA"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/txtNomeCurso6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inteligência Artificial &amp; Ciência de Dados"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTagCurso6"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txtDescCurso6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Fundamentos de IA, modelos de aprendizado de máquina e dados."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/bannerCurso6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtStatusBloqueado6"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="Requer conclusão do Módulo 5"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_option_unselected"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
