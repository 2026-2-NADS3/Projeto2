<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp"
    tools:context=".BaixarPDF">

    <Button
        android:id="@+id/btnVoltarTelaBaixarPDF"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_flat"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTituloBaixarPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Download de Certificado"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardDownload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:padding="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloBaixarPdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/iconPdf"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="PDF"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_logo_purple"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtNomeArquivoPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Certificado_Logica_Programacao.pdf"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/iconPdf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtInfoArquivoPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tamanho: 1.2 MB • Documento PDF Autêntico"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtNomeArquivoPdf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnBaixarPdfConfirmar"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="Baixar Arquivo PDF"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_green"
            app:backgroundTint="@null"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtInfoArquivoPdf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
