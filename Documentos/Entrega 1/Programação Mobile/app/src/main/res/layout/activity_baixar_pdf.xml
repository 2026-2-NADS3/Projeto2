<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp"
    tools:context=".BaixarPDF">

    <Button
        android:id="@+id/btnVoltarTelaBaixarPDF"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:contentDescription="Voltar"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_flat"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTituloBaixarPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Download de Certificado"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollDownload"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloBaixarPdf"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:padding="24dp">

            <!-- Logo da Próxima Etapa (arquivo: res/drawable/imglogo) -->
            <ImageView
                android:id="@+id/imgLogoDownload"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/imglogo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Logo Próxima Etapa"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtNomeArquivoPdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Certificado_Logica_Programacao.pdf"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/imgLogoDownload"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtInfoArquivoPdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documento PDF gerado no seu celular"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/txtNomeArquivoPdf"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnBaixarPdfConfirmar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:text="Baixar Arquivo PDF"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_green"
                app:backgroundTint="@null"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txtInfoArquivoPdf"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Linha fina separando o download do compartilhar -->
            <View
                android:id="@+id/divisorCompartilhar"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/btnBaixarPdfConfirmar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtLabelCompartilhar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPARTILHAR"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/divisorCompartilhar"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Cartão do WhatsApp: o nome fica embaixo, o ícone vem por cima (mais abaixo no arquivo) -->
            <Button
                android:id="@+id/btnCompartilharWhatsapp"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:text="WhatsApp"
                android:contentDescription="Enviar certificado no WhatsApp"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_secondary"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintTop_toBottomOf="@id/txtLabelCompartilhar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCompartilharLinkedin" />

            <!-- Cartão do LinkedIn (publicar um post) -->
            <Button
                android:id="@+id/btnCompartilharLinkedin"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:text="LinkedIn"
                android:contentDescription="Postar certificado no LinkedIn"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_secondary"
                app:backgroundTint="@null"
                android:layout_marginStart="6dp"
                app:layout_constraintTop_toTopOf="@id/btnCompartilharWhatsapp"
                app:layout_constraintStart_toEndOf="@id/btnCompartilharWhatsapp"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Link discreto: coloca o certificado no perfil do LinkedIn -->
            <Button
                android:id="@+id/btnAdicionarLinkedin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Adicionar ao perfil do LinkedIn ›"
                android:textColor="#8B5CF6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="?attr/selectableItemBackground"
                app:backgroundTint="@null"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/btnCompartilharWhatsapp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Ícones grandes por cima dos cartões (ficam depois no arquivo de propósito) -->
            <ImageView
                android:id="@+id/iconWhatsapp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_whatsapp"
                android:elevation="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toTopOf="@id/btnCompartilharWhatsapp"
                app:layout_constraintStart_toStartOf="@id/btnCompartilharWhatsapp"
                app:layout_constraintEnd_toEndOf="@id/btnCompartilharWhatsapp" />

            <ImageView
                android:id="@+id/iconLinkedinPostar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_linkedin"
                android:elevation="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toTopOf="@id/btnCompartilharLinkedin"
                app:layout_constraintStart_toStartOf="@id/btnCompartilharLinkedin"
                app:layout_constraintEnd_toEndOf="@id/btnCompartilharLinkedin" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>