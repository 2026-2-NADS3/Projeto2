<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp"
    tools:context=".Visualizar">

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_flat"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTituloVisualizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Visualizar Certificado"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollCertificadoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloVisualizar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frameCertificado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="24dp"
                android:elevation="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtTagCert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÓXIMA ETAPA"
                    android:textColor="#8B5CF6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtHeaderCert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CERTIFICADO DE CONQUISTA"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/txtTagCert"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtSubCert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certificamos que o(a) estudante"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/txtHeaderCert"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtNomeAlunoCertificado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAVI LOURENÇO"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/txtSubCert"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtCorpoCert"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="concluiu com êxito a formação em Lógica de Programação com carga horária total de 40 horas."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/txtNomeAlunoCertificado"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtFooterCert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emitido em 15/10/2026 • Código: PE-2026-8841"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/txtCorpoCert"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
